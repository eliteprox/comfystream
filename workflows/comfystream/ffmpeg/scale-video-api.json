    "class_type": "ImageScale",
    "inputs": {
      "image": ["2", 0],
      "upscale_method": "lanczos",
      "width": 0,
      "height": 720,
      "crop": "disabled"
    }
  },
  "4": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["3", 0], "fps": ["2", 2], "audio": ["2", 1]}
  },
  "5": {
    "class_type": "SaveVideo",
    "inputs": {"video": ["4", 0], "filename_prefix": "ffmpeg/scale", "format": "mp4"}
  }
