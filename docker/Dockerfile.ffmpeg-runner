# Comfy-backed ffmpeg capabilities. The base image already has ComfyUI.
# This overlay replaces the runner source. It does not install an ffmpeg binary.
FROM comfystream-h3-runner:latest

COPY src /workspace/comfystream/src
COPY server/ffmpeg_runner.py /workspace/comfystream/server/ffmpeg_runner.py
COPY workflows/comfystream/ffmpeg /workspace/comfystream/workflows/comfystream/ffmpeg
COPY configs/realtime-ffmpeg.yaml /workspace/comfystream/configs/realtime-ffmpeg.yaml
COPY test/test_ffmpeg_tools.py /workspace/comfystream/test/test_ffmpeg_tools.py
COPY __init__.py /workspace/comfystream/__init__.py
COPY nodes /workspace/comfystream/nodes

# Folder name must not be "comfystream": that name is the Python package on PYTHONPATH.
RUN rm -rf /workspace/ComfyUI/custom_nodes/comfystream \
    && ln -sfn /workspace/comfystream /workspace/ComfyUI/custom_nodes/ComfyStreamNodes

# livepeer-swarm from the merged liverunner + pre-signed upload branch.
# Import name is livepeer_swarm. The batch key stays on the caller.
ARG SWARM_REF=af13cd58a4d6e6fd6360ec898df0ae252284b6e5
RUN /workspace/.venv/bin/python -m pip install --no-cache-dir \
    "git+https://github.com/eliteprox/runner-app-examples.git@${SWARM_REF}#subdirectory=packages/swarm-publish"

ENV PYTHONPATH=/workspace/comfystream/src \
    COMFYUI_CWD=/workspace/ComfyUI \
    COMFYSTREAM_FFMPEG_CONFIG=/workspace/comfystream/configs/realtime-ffmpeg.yaml

# Spawned Comfy workers do not run the batch initializer. This import hook
# pins their input directory before LoadImage validation.
RUN printf '%s\n' 'import comfystream_ffmpeg_paths' \
    > /workspace/.venv/lib/python3.12/site-packages/comfystream-ffmpeg-paths.pth

ENTRYPOINT ["/workspace/.venv/bin/python", "/workspace/comfystream/server/ffmpeg_runner.py"]
